# Copy this file to .env for local use. On Vercel, add these in Project Settings > Environment Variables.

# Coach login (change these before deploying)
COACH_USERNAME=coach
COACH_PASSWORD=dragon123
# Any long random string; signs the login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Database. Leave both empty locally to use the file server/dragonboat.db.
# For Vercel, create a free Turso database and paste its URL and token here.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
